generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
  ENTERPRISE
}

enum PublicationVisibility {
  PUBLIC
  PRIVATE
}

enum PublicationRole {
  OWNER
  ADMIN
  EDITOR
  WRITER
  CONTRIBUTOR
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  COMMENT
  LIKE
  RATING
  REPLY
  SYSTEM
  FOLLOW
  PUBLICATION_INVITE
  MEMBERSHIP
  ARTICLE_PUBLISHED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum TraceRole {
  EDITOR
  CONTRIBUTOR
}

enum DocumentLinkType {
  RELATED
  PREVIOUS
  NEXT
  PART_OF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String    @unique
  bio           String?
  website       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions             Session[]
  accounts             Account[]
  repositories         Repository[]         @relation("RepoOwner")
  documents            Document[]           @relation("DocumentAuthor")
  documentsEdited      Document[]           @relation("DocumentLastEditor")
  comments             Comment[]
  ratings              Rating[]
  docLikes             DocumentLike[]
  commentLikes         CommentLike[]
  bookmarks            Bookmark[]
  notifications        Notification[]       @relation("NotificationRecipient")
  sentNotifs           Notification[]       @relation("NotificationActor")
  documentViews        DocumentView[]
  readingProgress      ReadingProgress[]
  followers            UserFollow[]         @relation("UserFollowers")
  following            UserFollow[]         @relation("UserFollowing")
  ownedPublications    Publication[]        @relation("PublicationOwner")
  publicationMembers   PublicationMember[]
  publicationFollows   PublicationFollow[]
  traceFollows         TraceFollow[]
  traceMembers         TraceMember[]
  documentRevisions    DocumentRevision[]
  interests            UserInterest[]
  contentReports       ContentReport[]      @relation("Reporter")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Publication {
  id           String                @id @default(cuid())
  name         String
  handle       String                @unique
  description  String?
  logo         String?
  coverImage   String?
  visibility   PublicationVisibility @default(PUBLIC)
  ownerId      String
  owner        User                  @relation("PublicationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  repositoryId String                @unique
  repository   Repository            @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  members   PublicationMember[]
  followers PublicationFollow[]
  articles  Document[]

  @@index([ownerId])
}

model PublicationMember {
  id            String          @id @default(cuid())
  publicationId String
  publication   Publication     @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          PublicationRole
  createdAt     DateTime        @default(now())

  @@unique([publicationId, userId])
  @@index([userId])
}

model PublicationFollow {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([publicationId, userId])
}

model Repository {
  id          String               @id @default(cuid())
  name        String
  slug        String
  description String?
  visibility  RepositoryVisibility @default(PUBLIC)
  ownerId     String
  owner       User                 @relation("RepoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  folders     Folder[]
  documents   Document[]
  publication Publication?
  followers   TraceFollow[]
  members     TraceMember[]

  @@unique([ownerId, slug])
}

/// Product concept: Trace — backed by Repository (no separate table)
model TraceFollow {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([repositoryId, userId])
  @@index([userId])
}

model TraceMember {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         TraceRole
  createdAt    DateTime   @default(now())

  @@unique([repositoryId, userId])
  @@index([userId])
}

model Folder {
  id           String     @id @default(cuid())
  name         String
  slug         String
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]   @relation("FolderTree")
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  documents Document[]

  @@unique([repositoryId, parentId, slug])
}

model Document {
  id                  String        @id @default(cuid())
  title               String
  subtitle            String?
  slug                String
  content             String        @default("")
  excerpt             String?
  coverImage          String?
  status              ArticleStatus @default(PUBLISHED)
  publishedAt         DateTime?
  readingMinutes      Int           @default(5)
  readerCount         Int           @default(0)
  readingMinutesTotal Int           @default(0)
  repositoryId        String
  repository          Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  publicationId       String?
  publication         Publication?  @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  folderId            String?
  folder              Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  authorId            String
  author              User          @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lastEditedById      String?
  lastEditedBy        User?         @relation("DocumentLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  comments        Comment[]
  ratings         Rating[]
  likes           DocumentLike[]
  bookmarks       Bookmark[]
  views           DocumentView[]
  tags            DocumentTag[]
  readingProgress ReadingProgress[]
  linksFrom       DocumentLink[] @relation("DocumentLinkFrom")
  linksTo         DocumentLink[] @relation("DocumentLinkTo")
  revisions       DocumentRevision[]

  @@unique([repositoryId, slug])
  @@index([readerCount])
  @@index([updatedAt])
  @@index([status, publishedAt])
  @@index([publicationId, status])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tagId])
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  documents DocumentTag[]
  interests UserInterest[]
  createdAt DateTime       @default(now())
}

model DocumentTag {
  documentId String
  tagId      String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

model Comment {
  id         String    @id @default(cuid())
  content    String
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  likeCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  likes CommentLike[]
}

model Rating {
  id         String   @id @default(cuid())
  value      Int
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([documentId, userId])
}

model DocumentLike {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Bookmark {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([documentId, userId])
}

model ReadingProgress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  progress   Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([userId, documentId])
  @@index([userId, updatedAt])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model ContentReport {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([targetType, targetId])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  eventType  String
  userId     String?
  entityType String?
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model DocumentRevision {
  id             String        @id @default(cuid())
  documentId     String
  document       Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revisionNumber Int
  title          String
  subtitle       String?
  content        String
  excerpt        String?
  status         ArticleStatus
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([documentId, revisionNumber])
  @@index([documentId, createdAt])
}

model DocumentLink {
  id             String           @id @default(cuid())
  fromDocumentId String
  fromDocument   Document         @relation("DocumentLinkFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocumentId   String
  toDocument     Document         @relation("DocumentLinkTo", fields: [toDocumentId], references: [id], onDelete: Cascade)
  type           DocumentLinkType
  createdAt      DateTime         @default(now())

  @@unique([fromDocumentId, toDocumentId, type])
  @@index([toDocumentId])
}

model DocumentView {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  durationSeconds Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([documentId, createdAt])
}
